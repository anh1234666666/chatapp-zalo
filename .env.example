# Supabase Configuration
# Lấy từ Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Gemini AI API Key (Dùng cho tính năng Trợ lý AI Streaming)
# Lấy miễn phí tại: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Tùy chọn cấu hình WebRTC TURN server (nếu kết nối qua mạng 4G/NAT phức tạp)
# Nếu không cung cấp, app sẽ dùng Google Public STUN servers mặc định
VITE_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]}]
